[sub_resource type="GDScript" id="GDScript_jo7ee"]
resource_name = "QuarterRingShapeApplier"
script/source = "extends CPUParticles3D

@export var radius: float = 2.0
@export var point_count: int = 32

func _ready() -> void:
	emission_shape = EMISSION_SHAPE_POINTS
	var points: PackedVector3Array = []
	
	for i in range(point_count):
		# 0 to 90 degrees in radians (PI / 2)
		var angle := (float(i) / float(point_count - 1)) * (PI / 2.0)
		var x := cos(angle) * radius
		var z := sin(angle) * radius
		points.append(Vector3(x, 0, z))
		
	emission_points = points
"

