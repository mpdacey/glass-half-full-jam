size_flags_horizontal = 3

[node name="Twinkle3" type="TextureRect" parent="LivesUIMargin/BanishPanel/TwinklesMargin/TwinklesHBox/TwinkleAnchor3"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -256.0
offset_top = -256.0
offset_right = 256.0
offset_bottom = 256.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(256, 256)
texture = ExtResource("4_k270f")

[node name="LivesUIAnimator" type="AnimationPlayer" parent="."]
libraries = {
&"": SubResource("AnimationLibrary_tnpra")
}

[node name="InfoBox" parent="." instance=ExtResource("4_nkiqw")]
metadata/content = ExtResource("5_n0csj")

[node name="SpendLifeDeniedListener" type="Node" parent="InfoBox"]
script = ExtResource("5_tnpra")
global_signal_name = &"spend_life_denied"
metadata/_custom_type_script = "uid://lu4gei6pype6"

[connection signal="banish_requested" from="." to="LivesUIAnimator" method="play" binds= [&"banish"]]
[connection signal="lives_value_changed" from="." to="LivesUIAnimator" method="play" binds= [&"flash"]]
[connection signal="action_button_pressed" from="InfoBox" to="InfoBox" method="dismiss_info_box"]
[connection signal="action_button_pressed" from="InfoBox" to="." method="emit_signal" binds= [&"open_shop_requested"]]
[connection signal="global_signal_emitted" from="InfoBox/SpendLifeDeniedListener" to="InfoBox" method="display_info_box" flags=3]
