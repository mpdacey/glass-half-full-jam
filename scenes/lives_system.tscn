[node name="LivesSystem" type="Node" node_paths=PackedStringArray("lives_save_controller", "regen_timer", "timeout_timer")]
process_mode = 3
script = ExtResource("1_mtu6a")
lives_save_controller = NodePath("LivesSaveController")
regen_timer = NodePath("FullRegenerationTimer")
timeout_timer = NodePath("ConnectionTimeoutTimer")

[node name="FullRegenerationTimer" type="Timer" parent="."]
