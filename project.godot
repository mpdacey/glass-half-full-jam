; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gas Half Fuel"
config/version="Closed Testing 1.4.0"
run/main_scene="uid://kaxdymo06lyx"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(0.09, 0.080835, 0.07830001, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/image="uid://eyw4c58nywm3"
config/icon="uid://eyw4c58nywm3"

[audio]

buses/default_bus_layout="uid://b58uipc4yr7ob"

[autoload]

GodotPlayGameServices="*uid://yd58th0264ab"
GlobalTimeInterfacer="*res://scenes/global_time_interfacer.tscn"
InternetConnectionChecker="*res://scenes/internet_connection_checker.tscn"
OptionsConfigManager="*res://scripts/global/options_config_manager.gd"
UserConfigManager="*res://scripts/global/user_config_manager.gd"
GlobalSignalBus="*res://scripts/global/global_signal_bus.gd"
GlobalConstants="*res://scripts/global/global_constants.gd"
MusicPlayer="*res://scenes/music_manager.tscn"
LivesSystem="*res://scenes/lives_system.tscn"
ScreenshotGrabber="*res://scripts/editor/screenshot_grabber.gd"
PurchaseController="*res://scripts/billing/purchase_controller.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1080
window/size/viewport_height=2280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotAndroidInAppUpdate/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/GodotPlayGameServices/plugin.cfg")

[input]

screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194335,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

sensors/enable_gyroscope=true

[layer_names]

3d_physics/layer_1="Pickups"
3d_physics/layer_2="Obstacle"
3d_physics/layer_3="PlayerProximity"
3d_physics/layer_4="PlayerHurtbox"
3d_physics/layer_5="Road"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=3
2d/snap/snap_2d_transforms_to_pixel=true
